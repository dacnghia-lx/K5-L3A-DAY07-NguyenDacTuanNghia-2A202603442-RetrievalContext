# Copy to .env (never commit .env). Any OpenAI-compatible provider with tool calling.
LLM_API_KEY=
# Gemini (Google AI Studio, free tier):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=<model>
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<model>
# Optional, for cost reporting (USD per 1M tokens); leave 0 for free tier.
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0
